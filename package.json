{
  "name": "saas-starter-kit",
  "version": "1.6.0",
  "private": true,
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  },
  "scripts": {
    "release": "git checkout release && git merge origin/main && release-it && git checkout main && git merge origin/release && git push origin main",
    "dev": "next dev --webpack --port 4002",
    "build": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start --port 4002",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check .",
    "check-lint": "eslint -c eslint.config.cjs ./",
    "check-unused": "npx knip",
    "format": "prettier --write .",
    "test-all": "npm run check-format && npm run check-lint && npm run check-types && npm run build",
    "playwright:update": "playwright install && playwright install-deps",
    "test:e2e": "playwright test -x",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --env=jsdom",
    "test:integration": "prisma migrate deploy && INTEGRATION=1 jest __tests__/integration --runInBand",
    "build-ci": "next build --webpack",
    "sync-stripe": "node --env-file .env sync-stripe.js",
    "check-locale": "node check-locale.js",
    "delete-team": "node --env-file .env delete-team.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/s3-request-presigner": "3.1171.0",
    "@boxyhq/metrics": "0.3.0",
    "@boxyhq/react-ui": "3.6.0",
    "@boxyhq/saml-jackson": "26.2.0",
    "@heroicons/react": "2.2.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.19.3",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.3.1",
    "@retracedhq/logs-viewer": "2.10.1",
    "@retracedhq/retraced": "0.7.23",
    "@sentry/nextjs": "10.78.0",
    "@tailwindcss/typography": "0.5.20",
    "bcryptjs": "3.0.3",
    "classnames": "2.5.1",
    "cookies-next": "6.1.1",
    "currency-symbol-map": "5.1.0",
    "formik": "2.4.9",
    "i18next": "25.10.10",
    "micromatch": "4.0.8",
    "mixpanel-browser": "2.86.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "next-i18next": "15.4.3",
    "nodemailer": "7.0.13",
    "react": "18.3.1",
    "react-daisyui": "5.0.5",
    "react-dom": "18.3.1",
    "react-email": "6.11.16",
    "react-google-recaptcha": "3.1.0",
    "react-hot-toast": "2.6.1",
    "react-i18next": "15.5.3",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5",
    "slack-notify": "2.0.7",
    "stripe": "17.7.0",
    "svix": "1.99.1",
    "swr": "2.5.1",
    "yup": "1.7.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "6.10.0",
    "@types/jest": "30.0.0",
    "@types/micromatch": "4.0.10",
    "@types/mixpanel-browser": "2.66.0",
    "@types/node": "25.9.9",
    "@types/nodemailer": "7.0.12",
    "@types/react": "18.3.31",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "autoprefixer": "10.6.2",
    "daisyui": "4.12.24",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "node-mocks-http": "1.18.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "release-it": "20.2.1",
    "tailwindcss": "3.4.19",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "typeorm": {
      "mssql": ">=11.0.0"
    },
    "react-email": {
      "esbuild": ">=0.25.0",
      "next": ">=15.2.3"
    },
    "@react-email/components": {
      "prismjs": ">=1.30.0"
    }
  }
}
