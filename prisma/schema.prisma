generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  MEMBER
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  emailVerified          DateTime?
  password               String?
  image                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())
  invalid_login_attempts Int       @default(0)
  lockedAt               DateTime?

  candidateProfile        CandidateProfile?
  tenantCandidates        TenantCandidate[]
  candidateTags           CandidateTag[]
  talentPools             TalentPool[]
  savedJobs               SavedJob[]
  jobAssignments          JobAssignment[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  teamMembers             TeamMember[]
  accounts                Account[]
  sessions                Session[]
  invitations             Invitation[]
}

enum PortalStatus {
  ACTIVE
  SUSPENDED
}

model Team {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  domain          String?      @unique
  defaultRole     Role         @default(MEMBER)
  status          PortalStatus @default(ACTIVE)
  suspendedReason String?
  billingId       String?
  billingProvider String?
  // Phase 6: plan from the Stripe price metadata (or a platform-admin override)
  planKey         String       @default("free")
  planOverride    String?
  paymentFailedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now())
  members         TeamMember[]
  invitations     Invitation[]
  apiKeys         ApiKey[]

  usageCounters    UsageCounter[]
  portalDomains    PortalDomain[]
  integrations     Integration[]
  portalProfile    PortalProfile?
  portalBranding   PortalBranding?
  portalRoles      PortalRole[]
  jobs             Job[]
  pipelineStages   PipelineStage[]
  tenantCandidates TenantCandidate[]
  candidateTags    CandidateTag[]
  talentPools      TalentPool[]

  @@index([billingId])
}

model TeamMember {
  id           String   @id @default(uuid())
  teamId       String
  userId       String
  role         Role     @default(MEMBER)
  portalRoleId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalRole PortalRole? @relation(fields: [portalRoleId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([portalRoleId])
}

model Invitation {
  id             String   @id @default(uuid())
  teamId         String
  email          String?
  role           Role     @default(MEMBER)
  token          String   @unique
  expires        DateTime
  invitedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  sentViaEmail   Boolean  @default(true)
  allowedDomains String[] @default([])
  portalRoleId   String?

  user       User        @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  portalRole PortalRole? @relation(fields: [portalRoleId], references: [id], onDelete: SetNull)

  @@unique([teamId, email])
  @@index([email])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  teamId     String
  hashedKey  String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Subscription {
  id         String    @id
  customerId String
  priceId    String
  active     Boolean   @default(false)
  startDate  DateTime
  endDate    DateTime
  cancelAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())

  @@index([customerId])
}

model Service {
  id          String   @id @default(uuid())
  description String
  features    String[]
  image       String
  name        String
  created     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  Price       Price[]
}

model Price {
  id            String   @id @default(uuid())
  billingScheme String
  currency      String
  serviceId     String
  amount        Int?
  metadata      Json
  type          String
  created       DateTime

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model jackson_store {
  key        String    @id(map: "_jackson_store_key") @db.VarChar(1500)
  value      String
  iv         String?   @db.VarChar(64)
  tag        String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  modifiedAt DateTime? @db.Timestamp(6)
  namespace  String?   @db.VarChar(256)

  jackson_index jackson_index[]

  @@index([namespace], map: "_jackson_store_namespace")
  @@ignore
}

model jackson_index {
  id       Int    @id(map: "_jackson_index_id") @default(autoincrement())
  key      String @db.VarChar(1500)
  storeKey String @db.VarChar(1500)

  store jackson_store @relation(fields: [storeKey], references: [key], onDelete: Cascade, onUpdate: NoAction)

  @@index([key], map: "_jackson_index_key")
  @@index([key, storeKey], map: "_jackson_index_key_store")
  @@ignore
}

model jackson_ttl {
  key       String @id(map: "jackson_ttl_key") @db.VarChar(1500)
  expiresAt BigInt

  @@index([expiresAt], map: "_jackson_ttl_expires_at")
  @@ignore
}

// ---------------------------------------------------------------------------
// Job portal domain: tenant (Team = Portal) extensions
// ---------------------------------------------------------------------------

enum PortalTheme {
  LIGHT
  DARK
  SYSTEM
}

model PortalProfile {
  id                    String    @id @default(uuid())
  teamId                String    @unique
  companyName           String
  description           String?   @db.Text
  website               String?
  contactEmail          String?
  logoKey               String?
  industry              String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model PortalBranding {
  id                String      @id @default(uuid())
  teamId            String      @unique
  primaryColor      String      @default("#3346D3")
  theme             PortalTheme @default(SYSTEM)
  heroTitle         String?
  heroSubtitle      String?
  aboutHtml         String?     @db.Text
  privacyPolicyHtml String?     @db.Text
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  group       String
  createdAt   DateTime @default(now())

  roles PortalRolePermission[]
}

// teamId = null means a system template; teamId set means a per-portal role
// (either a copy of a system role, or a custom role).
model PortalRole {
  id          String   @id @default(uuid())
  teamId      String?
  key         String
  name        String
  description String?
  baseRole    Role     @default(MEMBER)
  isSystem    Boolean  @default(false)
  isOwnerRole Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team?                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  permissions PortalRolePermission[]
  members     TeamMember[]
  invitations Invitation[]

  @@unique([teamId, key])
  @@index([teamId])
}

model PortalRolePermission {
  roleId       String
  permissionId String

  role       PortalRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// Phase 2: jobs, candidates, applications, pipeline
// ---------------------------------------------------------------------------

enum JobStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum JobVisibility {
  PUBLIC
  UNLISTED
  INTERNAL
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobAssignmentKind {
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
}

enum QuestionType {
  TEXT
  SINGLE
  MULTI
  NUMBER
  BOOLEAN
}

enum StageKind {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN
}

enum ActivityType {
  APPLIED
  STAGE_CHANGED
  WITHDRAWN
  NOTE
  EMAIL
  AI_ASSESSMENT
  INTERVIEW
  OFFER
}

enum ConsentPurpose {
  APPLICATION
  TALENT_POOL
  AI_RECOMMENDATIONS
  MARKETING
}

enum ResumeParseStatus {
  PENDING
  PARSED
  NEEDS_REVIEW
  FAILED
}

model Job {
  id                  String                       @id @default(uuid())
  teamId              String
  title               String
  slug                String
  descriptionHtml     String                       @default("") @db.Text
  responsibilities    String[]                     @default([])
  status              JobStatus                    @default(DRAFT)
  publishAt           DateTime?
  publishedAt         DateTime?
  closesAt            DateTime?
  visibility          JobVisibility                @default(PUBLIC)
  employmentType      EmploymentType               @default(FULL_TIME)
  workMode            WorkMode                     @default(ONSITE)
  experienceMin       Int?
  experienceMax       Int?
  salaryMin           Int?
  salaryMax           Int?
  salaryCurrency      String                       @default("INR")
  salaryVisible       Boolean                      @default(false)
  department          String?
  industry            String?
  education           String?
  vacancies           Int                          @default(1)
  benefits            String[]                     @default([])
  companyInfoOverride String?                      @db.Text
  attributes          Json                         @default("{}")
  createdById         String?
  deletedAt           DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  // Generated column (see migration): full-text search over title/description
  search              Unsupported("tsvector")?
  // pgvector embedding (1536 dims) of the job text, maintained by the AI worker
  embedding           Unsupported("vector(1536)")?
  embeddedAt          DateTime?

  team         Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  skills       JobSkill[]
  locations    JobLocation[]
  assignments  JobAssignment[]
  questions    ScreeningQuestion[]
  applications JobApplication[]
  savedBy      SavedJob[]

  @@unique([teamId, slug])
  @@index([teamId, status, deletedAt])
  @@index([teamId, createdAt])
  @@index([search], type: Gin)
}

model JobSkill {
  id       String  @id @default(uuid())
  teamId   String
  jobId    String
  skill    String
  required Boolean @default(true)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, skill])
  @@index([teamId, jobId])
}

model JobLocation {
  id      String  @id @default(uuid())
  teamId  String
  jobId   String
  city    String?
  region  String?
  country String?
  lat     Float?
  lng     Float?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([teamId, jobId])
  @@index([teamId, city])
}

model JobAssignment {
  id     String            @id @default(uuid())
  teamId String
  jobId  String
  userId String
  kind   JobAssignmentKind

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId, kind])
  @@index([teamId, userId])
}

model ScreeningQuestion {
  id       String       @id @default(uuid())
  teamId   String
  jobId    String
  type     QuestionType
  prompt   String
  options  String[]     @default([])
  required Boolean      @default(false)
  order    Int          @default(0)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([teamId, jobId, order])
}

model CandidateProfile {
  id                 String                       @id @default(uuid())
  userId             String                       @unique
  headline           String?
  summary            String?                      @db.Text
  phone              String?
  location           String?
  preferredLocations String[]                     @default([])
  expectedSalary     Int?
  noticePeriodDays   Int?
  employmentStatus   String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  completeness       Int                          @default(0)
  // Generated tsvector over headline/summary/location (see migration) and a
  // pgvector embedding of the anonymised profile text (no name / contact data)
  search             Unsupported("tsvector")?
  embedding          Unsupported("vector(1536)")?
  embeddedAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         CandidateSkill[]
  experiences    CandidateExperience[]
  educations     CandidateEducation[]
  certifications CandidateCertification[]
  resumes        CandidateResume[]
}

model CandidateSkill {
  id        String @id @default(uuid())
  profileId String
  skill     String

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, skill])
}

model CandidateExperience {
  id          String    @id @default(uuid())
  profileId   String
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?   @db.Text

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CandidateEducation {
  id          String  @id @default(uuid())
  profileId   String
  institution String
  degree      String
  field       String?
  startYear   Int?
  endYear     Int?

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CandidateCertification {
  id        String  @id @default(uuid())
  profileId String
  name      String
  issuer    String?
  year      Int?

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CandidateResume {
  id          String            @id @default(uuid())
  profileId   String
  storageKey  String
  fileName    String
  mime        String
  size        Int
  version     Int               @default(1)
  isDefault   Boolean           @default(false)
  parseStatus ResumeParseStatus @default(PENDING)
  parsedJson  Json?
  parsedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())

  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  parsedFields ParsedField[]

  @@index([profileId, deletedAt])
}

model CandidateConsent {
  id            String         @id @default(uuid())
  userId        String
  teamId        String
  purpose       ConsentPurpose
  granted       Boolean
  grantedAt     DateTime       @default(now())
  revokedAt     DateTime?
  policyVersion String

  @@index([userId])
  @@index([teamId, purpose])
}

model TenantCandidate {
  id           String   @id @default(uuid())
  teamId       String
  userId       String?
  name         String
  email        String
  phone        String?
  source       String   @default("portal")
  mergedIntoId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  applications JobApplication[]
  notes        CandidateNote[]
  tagLinks     CandidateTagLink[]
  poolMembers  TalentPoolMember[]

  @@unique([teamId, email])
  @@index([teamId, userId])
  @@index([teamId, mergedIntoId])
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model PipelineStage {
  id        String    @id @default(uuid())
  teamId    String
  jobId     String?
  name      String
  order     Int
  kind      StageKind @default(ACTIVE)
  createdAt DateTime  @default(now())

  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([teamId, jobId, order])
}

model JobApplication {
  id                String    @id @default(uuid())
  teamId            String
  jobId             String
  tenantCandidateId String
  resumeId          String?
  stageId           String
  source            String    @default("portal")
  answers           Json      @default("{}")
  rejectionReason   String?
  withdrawnAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  job             Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenantCandidate TenantCandidate       @relation(fields: [tenantCandidateId], references: [id], onDelete: Cascade)
  resume          CandidateResume?      @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  stage           PipelineStage         @relation(fields: [stageId], references: [id], onDelete: Restrict)
  activities      ApplicationActivity[]
  interviews      Interview[]
  offers          Offer[]
  messageDrafts   MessageDraft[]
  assessments     MatchAssessment[]

  @@unique([jobId, tenantCandidateId])
  @@index([teamId, jobId, stageId])
  @@index([teamId, createdAt])
  @@index([tenantCandidateId])
}

// Append-only: the tenant guard refuses update/delete through the app client.
model ApplicationActivity {
  id            String       @id @default(uuid())
  teamId        String
  applicationId String
  actorUserId   String?
  type          ActivityType
  fromStageId   String?
  toStageId     String?
  payload       Json?
  createdAt     DateTime     @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([teamId, applicationId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 3: talent database, interviews, offers, messages, notifications,
// automation
// ---------------------------------------------------------------------------

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageKind {
  INTERVIEW_INVITE
  REJECTION
  OFFER
  STATUS_UPDATE
  CUSTOM
}

enum MessageStatus {
  DRAFT
  APPROVED
  SENT
  DISCARDED
}

model CandidateNote {
  id                String   @id @default(uuid())
  teamId            String
  tenantCandidateId String
  authorId          String?
  body              String   @db.Text
  createdAt         DateTime @default(now())

  tenantCandidate TenantCandidate @relation(fields: [tenantCandidateId], references: [id], onDelete: Cascade)

  @@index([teamId, tenantCandidateId, createdAt])
}

model CandidateTag {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  createdAt DateTime @default(now())

  team   Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  links  CandidateTagLink[]
  user   User?              @relation(fields: [userId], references: [id])
  userId String?

  @@unique([teamId, name])
}

model CandidateTagLink {
  id                String   @id @default(uuid())
  teamId            String
  tenantCandidateId String
  tagId             String
  createdAt         DateTime @default(now())

  tenantCandidate TenantCandidate @relation(fields: [tenantCandidateId], references: [id], onDelete: Cascade)
  tag             CandidateTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tenantCandidateId, tagId])
  @@index([teamId, tagId])
}

model TalentPool {
  id          String   @id @default(uuid())
  teamId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  team    Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members TalentPoolMember[]
  user    User?              @relation(fields: [userId], references: [id])
  userId  String?

  @@unique([teamId, name])
}

model TalentPoolMember {
  id                String   @id @default(uuid())
  teamId            String
  poolId            String
  tenantCandidateId String
  addedBy           String?
  createdAt         DateTime @default(now())

  pool            TalentPool      @relation(fields: [poolId], references: [id], onDelete: Cascade)
  tenantCandidate TenantCandidate @relation(fields: [tenantCandidateId], references: [id], onDelete: Cascade)

  @@unique([poolId, tenantCandidateId])
  @@index([teamId, tenantCandidateId])
}

model Interview {
  id               String          @id @default(uuid())
  teamId           String
  applicationId    String
  round            Int             @default(1)
  startsAt         DateTime
  durationMin      Int             @default(45)
  location         String?
  meetingUrl       String?
  calendarEventIds Json?
  status           InterviewStatus @default(SCHEDULED)
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  application  JobApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  participants InterviewParticipant[]
  feedback     InterviewFeedback[]
  reminders    InterviewReminder[]

  @@index([teamId, startsAt])
  @@index([teamId, applicationId])
}

model InterviewParticipant {
  id          String @id @default(uuid())
  teamId      String
  interviewId String
  userId      String

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([teamId, userId])
}

model InterviewFeedback {
  id             String         @id @default(uuid())
  teamId         String
  interviewId    String
  userId         String
  scores         Json
  recommendation Recommendation
  notes          String?        @db.Text
  submittedAt    DateTime       @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([teamId, interviewId])
}

// Idempotency for reminders: one row per (interview, kind)
model InterviewReminder {
  id          String   @id @default(uuid())
  teamId      String
  interviewId String
  kind        String
  sentAt      DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, kind])
  @@index([teamId])
}

model Offer {
  id            String      @id @default(uuid())
  teamId        String
  applicationId String
  fixed         Int
  variable      Int         @default(0)
  joiningBonus  Int         @default(0)
  currency      String      @default("INR")
  equityNote    String?
  startDate     DateTime?
  expiresAt     DateTime?
  terms         String?     @db.Text
  templateKey   String?
  status        OfferStatus @default(DRAFT)
  round         Int         @default(0)
  createdById   String?
  sentAt        DateTime?
  respondedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  application JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approvals   OfferApproval[]

  @@index([teamId, status])
  @@index([teamId, applicationId])
}

model OfferApproval {
  id             String         @id @default(uuid())
  teamId         String
  offerId        String
  approverUserId String
  round          Int
  order          Int
  status         ApprovalStatus @default(PENDING)
  comment        String?
  decidedAt      DateTime?

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, round, approverUserId])
  @@index([teamId, approverUserId, status])
}

model MessageDraft {
  id               String        @id @default(uuid())
  teamId           String
  applicationId    String?
  recipientEmail   String
  recipientName    String?
  kind             MessageKind
  subject          String
  body             String        @db.Text
  createdById      String?
  createdByAi      Boolean       @default(false)
  status           MessageStatus @default(DRAFT)
  approvedById     String?
  approvedAt       DateTime?
  sentAt           DateTime?
  error            String?
  automationRuleId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  application JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([teamId, status, createdAt])
}

model AutomationRule {
  id               String   @id @default(uuid())
  teamId           String
  name             String
  trigger          Json
  action           Json
  requiresApproval Boolean  @default(true)
  enabled          Boolean  @default(true)
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([teamId, enabled])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  teamId    String?
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id     String  @id @default(uuid())
  userId String
  type   String
  inApp  Boolean @default(true)
  email  Boolean @default(true)
  push   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// ---------------------------------------------------------------------------
// Phase 4: AI
// ---------------------------------------------------------------------------

enum AIProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  OPENAI_COMPATIBLE
}

// teamId = null is the platform default (managed by the platform admin).
model AIProviderConfig {
  id               String     @id @default(uuid())
  teamId           String?
  provider         AIProvider
  baseUrl          String?
  // AES-256-GCM (see lib/ai/crypto.ts). Never returned to a browser.
  encryptedApiKey  String?    @db.Text
  keyHint          String?
  modelByTier      Json       @default("{}")
  tierByFeature    Json       @default("{}")
  embeddingModel   String?
  enabledFeatures  Json       @default("{}")
  logRetentionDays Int        @default(30)
  monthlyCredits   Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([teamId])
}

model PromptTemplate {
  id        String   @id @default(uuid())
  key       String
  version   Int
  system    String?  @db.Text
  body      String   @db.Text
  schema    Json?
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([key, version])
}

model AIUsage {
  id            String   @id @default(uuid())
  teamId        String?
  userId        String?
  feature       String
  provider      String
  model         String
  promptKey     String
  promptVersion Int
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  credits       Int      @default(0)
  latencyMs     Int      @default(0)
  status        String
  error         String?
  createdAt     DateTime @default(now())

  @@index([teamId, createdAt])
  @@index([userId, createdAt])
}

// Redacted input/output of AI calls; deleted after the tenant's retention period.
model AIRequestLog {
  id        String   @id @default(uuid())
  teamId    String?
  usageId   String?
  feature   String
  input     String   @db.Text
  output    String?  @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([teamId, createdAt])
}

model ParsedField {
  id          String    @id @default(uuid())
  resumeId    String
  field       String
  value       Json
  confidence  Float
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  resume CandidateResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model MatchAssessment {
  id                 String   @id @default(uuid())
  teamId             String
  applicationId      String
  score              Int
  breakdown          Json
  matchedSkills      String[]
  missingSkills      String[]
  explanation        String   @db.Text
  evidence           Json
  suggestedQuestions String[]
  promptVersion      Int
  model              String
  createdAt          DateTime @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([teamId, applicationId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 5: Web Push
// ---------------------------------------------------------------------------

// One row per browser/device a user agreed to receive push on. Creating the
// row is the consent; deleting it (or the user unsubscribing) withdraws it.
model PushSubscription {
  id         String    @id @default(uuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Phase 6: entitlements, domains, integrations, platform admin
// ---------------------------------------------------------------------------

// Editable by the platform admin; code defaults in lib/entitlements.ts fill the gaps.
model PlanEntitlement {
  plan      String   @id
  limits    Json
  features  String[]
  updatedAt DateTime @updatedAt
}

// Metered usage per portal and month (gauges are set by the nightly reconciliation).
model UsageCounter {
  id          String   @id @default(uuid())
  teamId      String
  metric      String
  periodStart DateTime
  value       Float    @default(0)
  updatedAt   DateTime @updatedAt
  team        Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId, metric, periodStart])
  @@index([teamId, periodStart])
}

model PortalDomain {
  id                String    @id @default(uuid())
  teamId            String
  hostname          String
  verificationToken String
  verifiedAt        DateTime?
  certificateStatus String    @default("PENDING")
  lastCheckedAt     DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  team              Team      @relation(fields: [teamId], references: [id])

  @@unique([teamId, hostname])
  @@index([hostname])
}

// Append-only record of what platform admins did.
model PlatformAuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  actorEmail   String
  action       String
  targetTeamId String?
  details      Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetTeamId, createdAt])
}

// A connected third-party app. Secrets are encrypted (AES-256-GCM) and never returned.
model Integration {
  id                   String   @id @default(uuid())
  teamId               String
  provider             String
  kind                 String
  status               String   @default("CONNECTED")
  accountLabel         String?
  config               Json     @default("{}")
  encryptedCredentials String?
  connectedById        String?
  lastError            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  team                 Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId, provider])
}
